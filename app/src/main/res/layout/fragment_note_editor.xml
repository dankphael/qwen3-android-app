<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    tools:context=".ui.notes.NoteEditorFragment">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="0dp"
        android:layout_height="@dimen/toolbar_height"
        android:paddingHorizontal="@dimen/screen_h_padding"
        android:background="@color/surface"
        app:elevation="2dp"
        app:titleTextAppearance="@style/TextAppearance.Qwen.TitleMedium"
        app:titleTextColor="@color/on_surface"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:menu="@menu/toolbar_note_editor"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tabLayout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/surface"
        app:tabIndicatorColor="@color/primary"
        app:tabTextColor="@color/on_surface_variant"
        app:tabSelectedTextColor="@color/primary"
        app:tabIndicatorFullWidth="true"
        app:tabMode="fixed"
        app:tabGravity="fill"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/toolbar">

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Edit" />

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Preview" />
    </com.google.android.material.tabs.TabLayout>

    <LinearLayout
        android:id="@+id/infoBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/screen_h_padding"
        android:paddingVertical="@dimen/space_4"
        android:background="@color/background"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tabLayout">

        <TextView
            android:id="@+id/tvCharCount"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textAppearance="@style/TextAppearance.Qwen.LabelSmall"
            android:textColor="@color/on_surface_variant"
            tools:text="156 chars / 12 words" />

        <TextView
            android:id="@+id/tvAutoSave"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.Qwen.LabelSmall"
            android:textColor="@color/primary"
            android:text="Saved"
            android:visibility="gone"
            tools:visibility="visible" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/editScrollView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/infoBar"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <EditText
            android:id="@+id/etNoteContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="0dp"
            android:gravity="top|start"
            android:padding="@dimen/screen_h_padding"
            android:background="@null"
            android:textAppearance="@style/TextAppearance.Qwen.BodyMedium"
            android:textColor="@color/on_surface"
            android:hint="Start writing..."
            android:textColorHint="@color/on_surface_variant"
            android:typeface="monospace"
            android:inputType="textMultiLine|textCapSentences"
            android:importantForAutofill="no"
            android:scrollbars="vertical"
            tools:text="# Hello World\n\nThis is my note." />
    </ScrollView>

    <ScrollView
        android:id="@+id/previewScrollView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/infoBar"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/tvPreviewContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="@dimen/screen_h_padding"
            android:textAppearance="@style/TextAppearance.Qwen.BodyMedium"
            android:textColor="@color/on_surface"
            tools:text="# Hello World\n\nRendered content here." />
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
