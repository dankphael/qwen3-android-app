<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/emptyState"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:visibility="visible"
    tools:visibility="visible">

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/ivWelcomeIcon"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:src="@drawable/ic_welcome_illustration"
        android:layout_marginTop="64dp"
        android:layout_marginBottom="24dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvWelcomeTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"
        android:text="What can I help with?"
        android:textAppearance="@style/TextAppearance.Qwen.HeadlineMedium"
        android:textColor="@color/on_surface"
        android:gravity="center"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ivWelcomeIcon" />

    <TextView
        android:id="@+id/tvWelcomeSubtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:text="I'm your AI assistant. Ask me anything or choose a suggestion below."
        android:textAppearance="@style/TextAppearance.Qwen.BodyMedium"
        android:textColor="@color/on_surface_variant"
        android:gravity="center"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvWelcomeTitle" />

    <TextView
        android:id="@+id/tvModelInfo"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"
        android:text="Qwen3.5-0.8B"
        android:textAppearance="@style/TextAppearance.Qwen.LabelSmall"
        android:textColor="@color/primary"
        android:gravity="center"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvWelcomeSubtitle" />

    <!-- Suggestion chips: 2 rows of 2 -->
    <LinearLayout
        android:id="@+id/chipRow1"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"
        android:orientation="horizontal"
        android:gravity="center"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvModelInfo">

        <TextView
            android:id="@+id/chipSuggestion1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_chip"
            android:gravity="center"
            android:minHeight="40dp"
            android:elevation="2dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="Summarize the latest news"
            android:textAppearance="@style/TextAppearance.Qwen.BodySmall"
            android:textColor="@color/on_surface_variant"
            android:focusable="true"
            android:clickable="true"
            android:foreground="?attr/selectableItemBackground" />

        <TextView
            android:id="@+id/chipSuggestion2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_chip"
            android:gravity="center"
            android:minHeight="40dp"
            android:elevation="2dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="Explain quantum computing"
            android:textAppearance="@style/TextAppearance.Qwen.BodySmall"
            android:textColor="@color/on_surface_variant"
            android:focusable="true"
            android:clickable="true"
            android:foreground="?attr/selectableItemBackground" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/chipRow2"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"
        android:orientation="horizontal"
        android:gravity="center"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/chipRow1">

        <TextView
            android:id="@+id/chipSuggestion3"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_chip"
            android:gravity="center"
            android:minHeight="40dp"
            android:elevation="2dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="Write a poem about AI"
            android:textAppearance="@style/TextAppearance.Qwen.BodySmall"
            android:textColor="@color/on_surface_variant"
            android:focusable="true"
            android:clickable="true"
            android:foreground="?attr/selectableItemBackground" />

        <TextView
            android:id="@+id/chipSuggestion4"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_chip"
            android:gravity="center"
            android:minHeight="40dp"
            android:elevation="2dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="Help me debug code"
            android:textAppearance="@style/TextAppearance.Qwen.BodySmall"
            android:textColor="@color/on_surface_variant"
            android:focusable="true"
            android:clickable="true"
            android:foreground="?attr/selectableItemBackground" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>